### Settings screen.

settings-title = Settings
# Label for the language picker.
settings-language = Language
# Heading for the live formatting preview below the language picker.
settings-preview-heading = Formatting preview
# Variables:
#   $value (String) - an already formatted number, e.g. "1,234,567"
settings-preview-number = Number: { $value }
# Variables:
#   $date (String) - an already formatted date, e.g. "November 21, 2026"
settings-preview-date = Date: { $date }
# Shows locale-aware uppercasing of a sample word.
# Variables:
#   $text (String) - the uppercased sample
settings-preview-uppercase = Uppercase: { $text }
